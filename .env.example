# Required
DATABASE_URL=sqlite:///./outreach.db

# Days before a sent outreach is flagged as needing a follow-up (default: 5)
FOLLOW_UP_AFTER_DAYS_DEFAULT=5

# Gmail OAuth (uncomment when setting up)
# GOOGLE_CLIENT_SECRET_FILE=./client_secret.json   # downloaded from GCP Console
# GOOGLE_CREDENTIALS_FILE=./token.json             # written by `outreach-track auth`

# Pub/Sub (future — real-time sync)
# PUBSUB_SUBSCRIPTION_NAME=
# PUBSUB_PUSH_TOKEN=

# Claude API (required for reply classification)
# ANTHROPIC_API_KEY=
