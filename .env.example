# Stage 1 — required
DATABASE_URL=sqlite:///./outreach.db

# Stage 2 — Gmail OAuth (uncomment when setting up integrations)
# GOOGLE_CLIENT_SECRET_FILE=./client_secret.json   # downloaded from GCP Console
# GOOGLE_CREDENTIALS_FILE=./token.json             # written by `outreach-track auth`

# Stage 2 — Pub/Sub (uncomment when setting up webhook)
# PUBSUB_SUBSCRIPTION_NAME=
# PUBSUB_PUSH_TOKEN=

# Stage 3 — Claude API (uncomment when setting up classifier)
# ANTHROPIC_API_KEY=
