# Database
DATABASE_URL=sqlite:///./outreach.db

# Days before a sent outreach is flagged as needing a follow-up (default: 5)
FOLLOW_UP_AFTER_DAYS_DEFAULT=5

# Gmail OAuth — required for sync
# Download client_secret.json from GCP Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_SECRET_FILE=./client_secret.json
GOOGLE_CREDENTIALS_FILE=./token.json   # written automatically by `outreach-track auth`

# Claude API — required for reply classification
ANTHROPIC_API_KEY=sk-ant-...
